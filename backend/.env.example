# Provider credentials belong on this server, never in the mobile app.
SPROUT_PROVIDER=gemini
SPROUT_MODEL=gemini-3.5-flash-lite
# openai, gemini, or ollama; choose a model available to your account/runtime.
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
# Generate with: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
# This is a separate app-to-server access token, NOT a model provider API key.
SPROUT_APP_TOKEN=
SPROUT_HOST=127.0.0.1
SPROUT_PORT=8765
